        { "name": "Session endpoint", "url": "https://app.example.invalid/api/auth/session", "accepted": ["401"], "description": "Anonymous requests must get 401" },
        { "name": "Client downloads", "url": "https://downloads.example.invalid/client/latest.json", "interval": 300 }
      ]
    },
    {
      "name": "Core services on this host",
      "monitors": [
        { "name": "API", "url": "http://127.0.0.1:18080/healthz" },
        { "name": "Identity", "url": "http://127.0.0.1:4433/health/ready" }
      ]
    }
  ]
}
