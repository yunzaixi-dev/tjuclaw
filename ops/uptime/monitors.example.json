{
  "status_page": {
    "slug": "status",
    "title": "Example service status",
    "description": "Availability and response time of each component, measured once a minute."
  },
  "groups": [
    {
      "name": "Public entry points",
      "monitors": [
        { "name": "Web client", "url": "https://app.example.invalid/", "certificate_expiry": true },
