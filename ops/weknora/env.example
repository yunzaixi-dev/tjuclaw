# Copy to ignored ops/local/weknora/.env (task weknora:up does this).
# WeKnora is the knowledge engine only — not product identity, not library ACL.
# Pin a patched release. Do not use latest.

WEKNORA_VERSION=v0.8.0
GIN_MODE=release
TZ=Asia/Shanghai
AUTO_MIGRATE=true
WEKNORA_LANGUAGE=zh-CN
DEFAULT_LOCALE=zh-CN
DISABLE_REGISTRATION=false
WEKNORA_SANDBOX_DOCKER_ENABLED=false
OLLAMA_OPTIONAL=true
DOCREADER_ODL_HYBRID=off

FRONTEND_PORT=18180
WEKNORA_APP_HOST_PORT=18181

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora
DB_PASSWORD=change-me-db-password
DB_NAME=WeKnora

REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
STREAM_MANAGER_TYPE=redis

RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

JWT_SECRET=change-me-jwt-secret
SYSTEM_AES_KEY=change-me-system-aes-key-32b

# Optional OpenAI-compatible gateway (local NewAPI is not started by weknora:up).
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:3000/v1
# LLM_API_KEY=
# LLM_MODEL_NAME=
