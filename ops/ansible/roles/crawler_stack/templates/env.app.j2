NODE_ENV=production
HOST=0.0.0.0
PORT=3031
CRAWLER_DATABASE_URL=postgres://{{ crawler_db_user }}:{{ crawler_db_password }}@db:5432/{{ crawler_db_name }}
CRAWLER_SOURCES_FILE=/etc/crawler/sources.json
{% if crawler_s3_endpoint | default('') | length > 0 or crawler_final_s3_key | default('') | length > 0 %}
CRAWLER_S3_ENDPOINT={{ crawler_s3_endpoint }}
CRAWLER_S3_REGION={{ crawler_s3_region }}
CRAWLER_S3_BUCKET={{ crawler_s3_bucket }}
CRAWLER_S3_ACCESS_KEY_ID={{ crawler_final_s3_key }}
CRAWLER_S3_SECRET_ACCESS_KEY={{ crawler_final_s3_secret }}
{% if crawler_s3_prefix | default('') | length > 0 %}
CRAWLER_S3_PREFIX={{ crawler_s3_prefix }}
{% endif %}
{% endif %}
{% if crawler_wepeiyang_token | default('') | length > 0 %}
CRAWLER_WEPEIYANG_TOKEN={{ crawler_wepeiyang_token }}
{% endif %}
