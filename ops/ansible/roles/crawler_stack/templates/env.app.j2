NODE_ENV=production
HOST=0.0.0.0
PORT=3031
CRAWLER_DATABASE_URL=postgres://{{ crawler_db_user }}:{{ crawler_db_password }}@db:5432/{{ crawler_db_name }}
CRAWLER_SOURCES_FILE=/etc/crawler/sources.json
{% if crawler_archive_public_base_url | default('') | length > 0 %}
CRAWLER_ARCHIVE_PUBLIC_BASE_URL={{ crawler_archive_public_base_url }}
{% endif %}
{% if crawler_s3_endpoint | default('') | length > 0 or crawler_final_s3_key | default('') | length > 0 %}
CRAWLER_S3_ENDPOINT={{ crawler_s3_endpoint }}
CRAWLER_S3_REGION={{ crawler_s3_region }}
CRAWLER_S3_BUCKET={{ crawler_s3_bucket }}
CRAWLER_S3_ACCESS_KEY_ID={{ crawler_final_s3_key }}
CRAWLER_S3_SECRET_ACCESS_KEY={{ crawler_final_s3_secret }}
{% if crawler_s3_prefix | default('') | length > 0 %}
CRAWLER_S3_PREFIX={{ crawler_s3_prefix }}
{% endif %}
{% endif %}
{% if crawler_overseas_proxy | default('') | length > 0 %}
CRAWLER_OVERSEAS_PROXY={{ crawler_overseas_proxy }}
{% if crawler_overseas_proxy_hosts | default('') | length > 0 %}
CRAWLER_OVERSEAS_PROXY_HOSTS={{ crawler_overseas_proxy_hosts }}
{% endif %}
{% endif %}
{% if crawler_wepeiyang_token | default('') | length > 0 %}
CRAWLER_WEPEIYANG_TOKEN={{ crawler_wepeiyang_token }}
{% endif %}
{% if crawler_dajiala_key | default('') | length > 0 %}
CRAWLER_DAJIALA_KEY={{ crawler_dajiala_key }}
{% endif %}
{% if crawler_git_configured_count | default(0) | int == 4 %}
CRAWLER_GIT_RAW_URL={{ crawler_git_raw_url }}
CRAWLER_GIT_MARKDOWN_URL={{ crawler_git_markdown_url }}
CRAWLER_GIT_USERNAME={{ crawler_git_username }}
CRAWLER_GIT_TOKEN={{ crawler_git_token }}
CRAWLER_GIT_REGION={{ crawler_git_region }}
CRAWLER_GIT_SYNC_DIR=/data/git-sync
CRAWLER_GIT_SYNC_INTERVAL_SECONDS={{ crawler_git_sync_interval_seconds }}
{% endif %}
