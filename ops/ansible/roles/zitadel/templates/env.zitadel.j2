# ZITADEL environment configuration
ZITADEL_MASTERKEY={{ zitadel_masterkey }}
ZITADEL_DATABASE_POSTGRES_HOST=db
ZITADEL_DATABASE_POSTGRES_PORT=5432
ZITADEL_DATABASE_POSTGRES_DATABASE=zitadel
ZITADEL_DATABASE_POSTGRES_OPTIONS=
ZITADEL_DATABASE_POSTGRES_USER_USERNAME=zitadel
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD={{ zitadel_db_password }}
ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE=disable
ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME=postgres
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD={{ zitadel_db_password }}
ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE=disable

# External access & networking
ZITADEL_PORT=8080
ZITADEL_EXTERNALPORT={{ zitadel_external_port }}
ZITADEL_EXTERNALDOMAIN={{ zitadel_external_domain }}
ZITADEL_EXTERNALSECURE={{ 'true' if (zitadel_external_secure | bool) else 'false' }}
ZITADEL_TLS_ENABLED=false

# Machine bootstrap avoids creating a default-password human administrator.
ZITADEL_FIRSTINSTANCE_PATPATH=/bootstrap/owner.pat
ZITADEL_FIRSTINSTANCE_LOGINCLIENTPATPATH=/bootstrap/login-client.pat
ZITADEL_FIRSTINSTANCE_ORG_NAME=TJUClaw
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME=zitadel-owner
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME=Bootstrap Owner
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE={{ zitadel_pat_expiration }}
ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_USERNAME=login-client
ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_NAME=Login Client
ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_PAT_EXPIRATIONDATE={{ zitadel_pat_expiration }}

# SMTP configuration from remote env file
ZITADEL_DEFAULTINSTANCE_DOMAINPOLICY_SMTPSENDERADDRESSMATCHESINSTANCEDOMAIN=false
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_HOST={{ zitadel_smtp.host }}
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_USER={{ zitadel_smtp.username }}
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_PASSWORD={{ zitadel_smtp.password }}
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_TLS=true
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROM={{ zitadel_smtp_from_address }}
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROMNAME=TJUClaw
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_REPLYTOADDRESS={{ zitadel_smtp_from_address }}

# Single consistent 6-digit numeric 10-minute OTP codes for both email verification and login OTP
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_EMAILVERIFICATIONCODE_LENGTH=6
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_EMAILVERIFICATIONCODE_EXPIRY=10m
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_EMAILVERIFICATIONCODE_INCLUDELOWERLETTERS=false
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_EMAILVERIFICATIONCODE_INCLUDEUPPERLETTERS=false
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_EMAILVERIFICATIONCODE_INCLUDEDIGITS=true
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_EMAILVERIFICATIONCODE_INCLUDESYMBOLS=false
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_OTPEMAIL_LENGTH=6
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_OTPEMAIL_EXPIRY=10m
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_OTPEMAIL_INCLUDELOWERLETTERS=false
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_OTPEMAIL_INCLUDEUPPERLETTERS=false
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_OTPEMAIL_INCLUDEDIGITS=true
ZITADEL_DEFAULTINSTANCE_SECRETGENERATORS_OTPEMAIL_INCLUDESYMBOLS=false
