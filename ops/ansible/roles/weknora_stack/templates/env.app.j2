WEKNORA_VERSION={{ weknora_version }}
GIN_MODE=release
TZ=Asia/Shanghai
AUTO_MIGRATE=true
WEKNORA_LANGUAGE=zh-CN
DEFAULT_LOCALE=zh-CN
DISABLE_REGISTRATION={{ weknora_disable_registration | bool | ternary('true', 'false') }}
WEKNORA_SANDBOX_DOCKER_ENABLED=false
OLLAMA_OPTIONAL=true
DOCREADER_ODL_HYBRID=off
{% if weknora_bootstrap_admin_email | default('') | length > 0 %}
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL={{ weknora_bootstrap_admin_email }}
{% endif %}
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER={{ weknora_db_user }}
DB_PASSWORD={{ weknora_db_password }}
DB_NAME={{ weknora_db_name }}
REDIS_ADDR=redis:6379
REDIS_PASSWORD={{ weknora_redis_password }}
REDIS_DB=0
STREAM_MANAGER_TYPE=redis
RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
JWT_SECRET={{ weknora_jwt_secret }}
SYSTEM_AES_KEY={{ weknora_aes_key }}
{% if weknora_llm_base_url | default('') | length > 0 %}
LLM_PROVIDER=openai
LLM_BASE_URL={{ weknora_llm_base_url }}
LLM_API_KEY={{ weknora_llm_api_key }}
LLM_MODEL_NAME={{ weknora_llm_model_name }}
{% endif %}
