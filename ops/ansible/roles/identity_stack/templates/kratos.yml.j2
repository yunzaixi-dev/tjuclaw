---
# Production Kratos policy rendered by Ansible for TJUClaw
version: v1.3.0

serve:
  public:
    base_url: {{ identity_app_url | regex_replace('/+$', '') }}/api/kratos/
    cors:
      enabled: false
  admin:
    base_url: http://127.0.0.1:4434/

selfservice:
  default_browser_return_url: {{ identity_app_url | regex_replace('/+$', '') }}/auth/complete
  allowed_return_urls:
    - {{ identity_app_url | regex_replace('/+$', '') }}/auth/complete
  methods:
    password:
      enabled: true
      config:
        min_password_length: 8
        haveibeenpwned_enabled: false
        identifier_similarity_check_enabled: true
    oidc:
      enabled: false
    totp:
      enabled: false
    webauthn:
      enabled: false
    lookup_secret:
      enabled: false
    link:
      enabled: false
    code:
      enabled: true
      passwordless_enabled: true
      config:
        lifespan: 10m
        max_submissions: 5
  flows:
    error:
      ui_url: {{ identity_app_url | regex_replace('/+$', '') }}/auth/error
    login:
      ui_url: {{ identity_app_url | regex_replace('/+$', '') }}/auth/login
      lifespan: 10m
    registration:
      enabled: true
      style: unified
      ui_url: {{ identity_app_url | regex_replace('/+$', '') }}/auth/registration
      lifespan: 10m
      after:
        code:
          hooks:
            - hook: session
    verification:
      enabled: true
      use: code
      ui_url: {{ identity_app_url | regex_replace('/+$', '') }}/auth/verification
      lifespan: 10m
    recovery:
      enabled: false
    logout:
      after:
        default_browser_return_url: {{ identity_app_url | regex_replace('/+$', '') }}/auth/logged-out

session:
  lifespan: 720h
  cookie:
    persistent: true

cookies:
  path: /
  same_site: Lax

identity:
  default_schema_id: tjuclaw-email-v1
  schemas:
    - id: tjuclaw-email-v1
      url: file:///etc/config/kratos/identity.schema.json

log:
  level: warning
  format: json
  leak_sensitive_values: false

courier:
  smtp:
    from_name: TJUClaw
    from_address: {{ identity_smtp_from_address }}
  templates:
    login_code:
      valid:
        email:
          subject: file:///etc/config/kratos/mail/subject.gotmpl
          body:
            plaintext: file:///etc/config/kratos/mail/login.txt.gotmpl
            html: file:///etc/config/kratos/mail/login.html.gotmpl
    registration_code:
      valid:
        email:
          subject: file:///etc/config/kratos/mail/subject.gotmpl
          body:
            plaintext: file:///etc/config/kratos/mail/registration.txt.gotmpl
            html: file:///etc/config/kratos/mail/registration.html.gotmpl
    verification_code:
      valid:
        email:
          subject: file:///etc/config/kratos/mail/subject.gotmpl
          body:
            plaintext: file:///etc/config/kratos/mail/verification.txt.gotmpl
            html: file:///etc/config/kratos/mail/verification.html.gotmpl

feature_flags:
  use_continue_with_transitions: true
