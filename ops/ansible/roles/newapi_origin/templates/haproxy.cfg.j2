# Dedicated HAProxy configuration for tjuclaw-newapi-origin
# Generated by Ansible. Do not edit directly.
global
    log stdout format raw local0
    # Process management and user/group dropping if running as root
    maxconn 1024

defaults
    mode http
    log global
    timeout connect {{ newapi_origin_timeout_connect }}
    timeout client {{ newapi_origin_timeout_client }}
    timeout server {{ newapi_origin_timeout_server }}
    timeout tunnel {{ newapi_origin_timeout_tunnel }}

frontend newapi_tls_in
    bind :{{ newapi_origin_port }} ssl crt {{ newapi_origin_tls_pem }} ssl-min-ver TLSv1.2
    mode http

    # Only accept newapi.tjuclaw.cloud host header (with optional standard/custom ports)
    acl valid_host hdr(host) -i {{ newapi_origin_hostname }} {{ newapi_origin_hostname }}:443 {{ newapi_origin_hostname }}:{{ newapi_origin_port }}
    http-request deny deny_status 404 unless valid_host

    # Security: strip any client-supplied/forged X-Forwarded-For before setting client IP
    http-request del-header X-Forwarded-For
    http-request set-header X-Forwarded-For %[src]

    # Protocol and port headers
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443

    # This host is an administration/API gateway; never cache authenticated responses.
    http-response set-header Cache-Control "no-store"

    default_backend newapi_backend

backend newapi_backend
    mode http
    server newapi_app {{ newapi_origin_backend_address }}:{{ newapi_origin_backend_port }} check
