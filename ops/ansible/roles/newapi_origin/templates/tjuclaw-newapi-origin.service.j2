[Unit]
Description=TJUClaw NewAPI Dedicated HAProxy TLS Origin
Documentation=https://github.com/yunzaixi-dev/tjuclaw
After=network.target
Wants=network.target

[Service]
Type=notify
ExecStart=/usr/sbin/haproxy -Ws -f {{ newapi_origin_config_file }} -p /run/{{ newapi_origin_service_name }}.pid
ExecReload=/bin/kill -USR2 $MAINPID
Restart=always
RestartSec=3s
TimeoutStopSec=15s
KillMode=mixed

# Resource limits
MemoryMax={{ newapi_origin_memory_limit }}
MemoryHigh={{ newapi_origin_memory_limit }}

# Sandboxing and security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
