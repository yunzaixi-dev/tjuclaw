{
  "$id": "https://tjuclaw.agentwego.com/schemas/identity",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TJUClaw email identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "邮箱",
          "maxLength": 254,
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "code": { "identifier": true, "via": "email" }
            },
            "verification": { "via": "email" }
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
