{
  "$id": "https://tjuclaw.agentwego.com/schemas/identity-tju",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TJUClaw campus email identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "天津大学邮箱",
          "maxLength": 254,
          "pattern": "^[^@]+@[tT][jJ][uU]\\.[eE][dD][uU]\\.[cC][nN]$",
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "code": { "identifier": true, "via": "email" }
            },
            "verification": { "via": "email" }
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
