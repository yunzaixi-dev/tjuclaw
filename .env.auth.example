# Go API only. Copy to ignored .env.auth.local for task auth:serve.
# Never load this file or root .env.local into Vite.
HTTP_ADDR=127.0.0.1:8080
APP_PUBLIC_URL=https://app.tjuclaw.cloud
AUTH_PROVIDER=kratos
KRATOS_PUBLIC_URL=http://127.0.0.1:4433
# Base64-encoded 32 random bytes. Preserve this key across ordinary deployments.
AUTH_COOKIE_KEY=
CAP_URL=http://127.0.0.1:3300
CAP_SITE_KEY=
CAP_SECRET_KEY=
# Coordinated rollback only: AUTH_PROVIDER=zitadel plus ZITADEL_* settings.
# Keep the current client; do not mix the two provider flows.
# ZITADEL_URL=http://127.0.0.1:8085
# ZITADEL_DOMAIN=auth.tjuclaw.cloud
# ZITADEL_ORG_ID=
# ZITADEL_TOKEN=
# Product Chat Completions fallback when the account has no custom model.
# `task dev` copies these four keys from `.env.auth.local` into the API process.
# Do not use loopback :3000 while docs occupy that port.
# NEWAPI_BASE_URL=
# NEWAPI_API_KEY=
# NEWAPI_MODEL=
# NEWAPI_DAILY_QUOTA=20
