# Go API only. Copy to ignored .env.auth.local for task auth:serve.
# Never load this file or root .env.local into Vite.
HTTP_ADDR=127.0.0.1:8080
APP_PUBLIC_URL=https://app.tjuclaw.cloud
AUTH_PROVIDER=zitadel
ZITADEL_URL=http://127.0.0.1:8085
ZITADEL_DOMAIN=auth.tjuclaw.cloud
ZITADEL_ORG_ID=
# Dedicated IAM_LOGIN_CLIENT PAT, never the bootstrap owner's PAT.
ZITADEL_TOKEN=
# Base64-encoded 32 random bytes. Preserve this key across ordinary deployments.
AUTH_COOKIE_KEY=
CAP_URL=http://127.0.0.1:3300
CAP_SITE_KEY=
CAP_SECRET_KEY=
# Coordinated legacy rollback only: AUTH_PROVIDER=kratos plus KRATOS_PUBLIC_URL.
# The old client must be restored with the old provider; do not mix their flows.
