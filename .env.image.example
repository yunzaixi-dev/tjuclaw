# Copy this file to .env.image.local and fill in the provider endpoint and key.
IMAGE_API_BASE_URL=https://api.example.invalid/v1
IMAGE_API_PATH=/images/generations
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_MS=120000
