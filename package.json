{
  "name": "tjuclaw",
  "version": "0.0.45",
  "private": true,
 "license": "Apache-2.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --dir frontend build",
    "dev": "pnpm --dir frontend dev",
    "docs:dev": "pnpm --filter @tjuclaw/docs dev",
    "docs:build": "pnpm --filter @tjuclaw/docs build",
    "types:check": "pnpm -r types:check && pnpm --dir frontend types:check",
    "lint": "eslint scripts && pnpm -r lint && pnpm --dir frontend lint",
    "git:setup": "node scripts/setup-git.mjs",
    "git:check": "node scripts/git-policy.mjs check-index",
    "test:git": "node --test scripts/git-policy.test.mjs",
    "test:tooling": "node --test scripts/tooling.test.mjs scripts/gitlab-*.test.mjs scripts/prepare-gitlab-release.test.mjs scripts/auth-mail-config.test.mjs scripts/dev-ports.test.mjs scripts/weknora-stack.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.4",
    "globals": "^17.0.0",
    "yaml": "^2.8.0"
  }
}
