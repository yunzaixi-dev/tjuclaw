{
  "name": "tjuclaw",
  "version": "0.0.25",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.3.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "pnpm --filter @tjuclaw/client build",
    "dev": "pnpm --filter @tjuclaw/client dev",
    "docs:dev": "pnpm --filter @tjuclaw/docs dev",
    "docs:build": "pnpm --filter @tjuclaw/docs build",
    "types:check": "pnpm -r types:check",
    "lint": "eslint scripts && pnpm -r lint",
    "git:setup": "node scripts/setup-git.mjs",
    "git:check": "node scripts/git-policy.mjs check-index",
    "test:git": "node --test scripts/git-policy.test.mjs",
    "test:tooling": "node --test scripts/tooling.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.0.0",
    "yaml": "^2.8.0"
  }
}
